// Map management module for Water Dashboard
class MapManager {
    constructor() {
        this.map = null;
        // Wait for DOM content to be loaded
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', () => this.init());
        } else {
            this.init();
        }
    }

    init() {
        console.log('Starting map initialization...');
        
        // Initialize map when the container is ready
        const mapContainer = document.getElementById('map');
        if (!mapContainer) {
            console.error('Map container not found');
            this.showError('Map container not found');
            return;
        }

        // Check if MapLibre GL JS is loaded
        if (typeof maplibregl === 'undefined') {
            console.error('MapLibre GL JS not loaded');
            this.showError('Map library not loaded properly');
            return;
        }

        try {
            console.log('Creating map instance...');
            // Initialize basic MapLibre GL JS map
            this.map = new maplibregl.Map({
                container: 'map',
                style: {
                    version: 8,
                    sources: {
                        osm: {
                            type: 'raster',
                            tiles: ['https://tile.openstreetmap.org/{z}/{x}/{y}.png'],
                            tileSize: 256,
                            attribution: '© OpenStreetMap Contributors'
                        }
                    },
                    layers: [{
                        id: 'osm',
                        type: 'raster',
                        source: 'osm',
                        minzoom: 0,
                        maxzoom: 19
                    }]
                },
                center: [78.9629, 20.5937], // Center of India
                zoom: 5
            });

            // Add navigation control
            this.map.addControl(new maplibregl.NavigationControl(), 'top-right');

            // Add event listeners for map
            this.map.on('load', () => {
                console.log('Map loaded successfully');
                this.hideLoading();
                this.addLocationMarkers();
            });

            // Handle style data loading
            this.map.on('style.load', () => {
                console.log('Map style loaded');
            });

            // Handle errors
            this.map.on('error', (e) => {
                console.error('Map error:', e);
                this.showError('Map failed to load properly');
            });

            // Update zoom level display
            this.map.on('zoom', () => this.updateZoomLevel());
            this.map.on('moveend', () => this.updateZoomLevel());

            // Initial zoom level update
            this.updateZoomLevel();

        } catch (error) {
            console.error('Failed to initialize map:', error);
            this.showError(error.message || 'Failed to initialize map');
        }
    }

    hideLoading() {
        const overlay = document.getElementById('mapLoading');
        if (overlay) {
            overlay.style.display = 'none';
        }
    }

    showError(message) {
        const overlay = document.getElementById('mapLoading');
        if (overlay) {
            overlay.innerHTML = `
                <div class="text-center p-4">
                    <p class="text-red-600">${message}</p>
                    <button onclick="location.reload()" class="mt-4 px-4 py-2 bg-blue-500 text-white rounded">
                        Reload Page
                    </button>
                </div>
            `;
        }
    }

    addLocationMarkers() {
        console.log('Adding location markers...');
        
        // Sample locations data from data.js
        if (typeof window.sensorData === 'undefined' || !window.sensorData.locations) {
            console.error('No location data available');
            return;
        }

        window.sensorData.locations.forEach(location => {
            try {
                // Create custom marker element
                const el = document.createElement('div');
                el.className = 'marker';
                el.style.width = '24px';
                el.style.height = '24px';
                el.style.borderRadius = '50%';
                el.style.backgroundColor = location.status === 'active' ? '#10b981' : location.status === 'warning' ? '#f59e0b' : '#ef4444';
                el.style.border = '3px solid white';
                el.style.boxShadow = '0 2px 4px rgba(0,0,0,0.2)';
                el.style.cursor = 'pointer';

                // Create popup with location details
                const popup = new maplibregl.Popup({ 
                    offset: 25,
                    closeButton: true,
                    closeOnClick: true
                }).setHTML(`
                    <div class="p-4">
                        <h3 class="font-semibold text-gray-900 text-lg mb-2">${location.name}</h3>
                        <p class="text-sm text-gray-600 mb-3">${location.description}</p>
                        <div class="flex items-center justify-between">
                            <span class="text-sm font-medium">Status: 
                                <span class="text-${location.status === 'active' ? 'green' : 'yellow'}-600">
                                    ${location.status}
                                </span>
                            </span>
                            <span class="text-sm font-medium">Reading: 
                                <span class="text-${location.lastReading >= 80 ? 'green' : 'yellow'}-600">
                                    ${location.lastReading}%
                                </span>
                            </span>
                        </div>
                        <div class="text-xs text-gray-500 mt-2">
                            Sensors: ${location.sensors.join(', ')}
                        </div>
                    </div>
                `);

                // Add marker to map
                const marker = new maplibregl.Marker(el)
                    .setLngLat(location.coordinates)
                    .setPopup(popup)
                    .addTo(this.map);

                // Add hover effect
                el.addEventListener('mouseenter', () => {
                    el.style.transform = 'scale(1.1)';
                });
                el.addEventListener('mouseleave', () => {
                    el.style.transform = 'scale(1)';
                });

                // Add click handler
                el.addEventListener('click', () => {
                    // Highlight corresponding location in the list
                    const listItems = document.querySelectorAll('.location-item');
                    listItems.forEach(item => {
                        if (item.dataset.id === location.id.toString()) {
                            item.classList.add('active');
                            item.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                        } else {
                            item.classList.remove('active');
                        }
                    });
                });

            } catch (error) {
                console.error(`Error adding marker for ${location.name}:`, error);
            }
        });

        console.log(`Added ${window.sensorData.locations.length} markers to the map`);
    }

    centerOnLocation(coordinates) {
        if (!this.map) {
            console.error('Map not initialized');
            return;
        }

        if (!Array.isArray(coordinates) || coordinates.length !== 2) {
            console.error('Invalid coordinates:', coordinates);
            return;
        }

        try {
            this.map.flyTo({
                center: coordinates,
                zoom: 12,
                duration: 2000,
                essential: true // This animation is essential for the navigation
            });
        } catch (error) {
            console.error('Error centering map:', error);
        }
    }
}

// Initialize map manager when DOM is loaded
    updateZoomLevel() {
        const zoomLevelElement = document.getElementById('zoomLevel');
        if (zoomLevelElement && this.map) {
            const zoom = this.map.getZoom();
            zoomLevelElement.textContent = Math.round(zoom * 10) / 10;
        }
    }
}

document.addEventListener('DOMContentLoaded', () => {
    // Initialize map manager
    window.mapManager = new MapManager();

    // Handle fullscreen button
    const fullscreenBtn = document.getElementById('fullscreenBtn');
    if (fullscreenBtn) {
        fullscreenBtn.addEventListener('click', () => {
            const mapContainer = document.getElementById('map');
            if (document.fullscreenElement) {
                document.exitFullscreen();
            } else if (mapContainer) {
                mapContainer.requestFullscreen();
            }
        });
    }

    // Handle locate button
    const locateBtn = document.getElementById('locateBtn');
    if (locateBtn) {
        locateBtn.addEventListener('click', () => {
            if ("geolocation" in navigator) {
                navigator.geolocation.getCurrentPosition((position) => {
                    window.mapManager.centerOnLocation([position.coords.longitude, position.coords.latitude]);
                }, (error) => {
                    console.error('Error getting location:', error);
                });
            }
        });
    }
});