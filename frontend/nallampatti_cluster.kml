<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Nallampatti Village Cluster</name>
    <description>Water Quality Monitoring - 7 Villages in Salem District</description>
    
    <!-- Styles -->
    <Style id="villageStyle">
      <IconStyle>
        <Icon>
          <href>http://maps.google.com/mapfiles/kml/paddle/blu-circle.png</href>
        </Icon>
      </IconStyle>
      <LabelStyle>
        <scale>1.0</scale>
      </LabelStyle>
    </Style>
    
    <Style id="waterBodyStyle">
      <LineStyle>
        <color>ff0000ff</color>
        <width>3</width>
      </LineStyle>
      <PolyStyle>
        <color>4d0000ff</color>
      </PolyStyle>
    </Style>
    
    <Style id="clusterBoundary">
      <LineStyle>
        <color>ff00ff00</color>
        <width>2</width>
      </LineStyle>
      <PolyStyle>
        <color>1400ff00</color>
      </PolyStyle>
    </Style>
    
    <!-- Village Points -->
    <Folder>
      <name>Village Monitoring Locations</name>
      
      <Placemark>
        <name>Nallampatti</name>
        <description>
          <![CDATA[
            <b>நல்லம்பட்டி (Nallampatti)</b><br/>
            District: Salem<br/>
            Water Source: Village Tank<br/>
            Sensors: pH, Turbidity, Temperature, TDS<br/>
            Status: Active
          ]]>
        </description>
        <styleUrl>#villageStyle</styleUrl>
        <Point>
          <coordinates>78.1667,11.5833,0</coordinates>
        </Point>
      </Placemark>
      
      <Placemark>
        <name>Poolampatti</name>
        <description>
          <![CDATA[
            <b>புலம்பட்டி (Poolampatti)</b><br/>
            Distance from Nallampatti: 4 km<br/>
            Water Source: Agricultural Pond<br/>
            Sensors: pH, Turbidity, Temperature, TDS<br/>
            Status: Active
          ]]>
        </description>
        <styleUrl>#villageStyle</styleUrl>
        <Point>
          <coordinates>78.1500,11.6000,0</coordinates>
        </Point>
      </Placemark>
      
      <Placemark>
        <name>Thumbalpatti</name>
        <description>
          <![CDATA[
            <b>தும்பல்பட்டி (Thumbalpatti)</b><br/>
            Distance from Nallampatti: 5 km<br/>
            Water Source: Village Tank<br/>
            Sensors: pH, Turbidity, Temperature, TDS<br/>
            Status: Active
          ]]>
        </description>
        <styleUrl>#villageStyle</styleUrl>
        <Point>
          <coordinates>78.2000,11.5700,0</coordinates>
        </Point>
      </Placemark>
      
      <Placemark>
        <name>Karipatti</name>
        <description>
          <![CDATA[
            <b>காரிபட்டி (Karipatti)</b><br/>
            Distance from Nallampatti: 6 km<br/>
            Water Source: Village Pond<br/>
            Sensors: pH, Turbidity, Temperature, TDS<br/>
            Status: Active
          ]]>
        </description>
        <styleUrl>#villageStyle</styleUrl>
        <Point>
          <coordinates>78.1800,11.5500,0</coordinates>
        </Point>
      </Placemark>
      
      <Placemark>
        <name>Mallamooppampatti</name>
        <description>
          <![CDATA[
            <b>மல்லமூப்பம்பட்டி (Mallamooppampatti)</b><br/>
            Distance from Nallampatti: 7 km<br/>
            Water Source: Village Tank<br/>
            Sensors: pH, Turbidity, Temperature, TDS<br/>
            Status: Active
          ]]>
        </description>
        <styleUrl>#villageStyle</styleUrl>
        <Point>
          <coordinates>78.1800,11.6100,0</coordinates>
        </Point>
      </Placemark>
      
      <Placemark>
        <name>Chinnamanaickenpatti</name>
        <description>
          <![CDATA[
            <b>சின்னமணையக்கன்பட்டி (Chinnamanaickenpatti)</b><br/>
            Distance from Nallampatti: 5 km<br/>
            Water Source: Village Pond<br/>
            Sensors: pH, Turbidity, Temperature, TDS<br/>
            Status: Active
          ]]>
        </description>
        <styleUrl>#villageStyle</styleUrl>
        <Point>
          <coordinates>78.1400,11.5600,0</coordinates>
        </Point>
      </Placemark>
      
      <Placemark>
        <name>Pappampalayam</name>
        <description>
          <![CDATA[
            <b>பாப்பம்பாளையம் (Pappampalayam)</b><br/>
            Distance from Nallampatti: 8 km<br/>
            Water Source: Village Tank<br/>
            Sensors: pH, Turbidity, Temperature, TDS<br/>
            Status: Active
          ]]>
        </description>
        <styleUrl>#villageStyle</styleUrl>
        <Point>
          <coordinates>78.1600,11.6200,0</coordinates>
        </Point>
      </Placemark>
    </Folder>
    
    <!-- Water Bodies (Approximate Boundaries) -->
    <Folder>
      <name>Water Bodies</name>
      
      <Placemark>
        <name>Nallampatti Tank</name>
        <description>Main water source for Nallampatti village</description>
        <styleUrl>#waterBodyStyle</styleUrl>
        <Polygon>
          <outerBoundaryIs>
            <LinearRing>
              <coordinates>
                78.1650,11.5850,0
                78.1680,11.5850,0
                78.1680,11.5820,0
                78.1650,11.5820,0
                78.1650,11.5850,0
              </coordinates>
            </LinearRing>
          </outerBoundaryIs>
        </Polygon>
      </Placemark>
      
      <Placemark>
        <name>Poolampatti Pond</name>
        <description>Agricultural pond serving Poolampatti</description>
        <styleUrl>#waterBodyStyle</styleUrl>
        <Polygon>
          <outerBoundaryIs>
            <LinearRing>
              <coordinates>
                78.1485,11.6015,0
                78.1510,11.6015,0
                78.1510,11.5990,0
                78.1485,11.5990,0
                78.1485,11.6015,0
              </coordinates>
            </LinearRing>
          </outerBoundaryIs>
        </Polygon>
      </Placemark>
    </Folder>
    
    <!-- Cluster Boundary -->
    <Folder>
      <name>Monitoring Cluster Area</name>
      
      <Placemark>
        <name>Nallampatti Cluster Boundary</name>
        <description>7-village water quality monitoring network covering ~100 sq km</description>
        <styleUrl>#clusterBoundary</styleUrl>
        <Polygon>
          <outerBoundaryIs>
            <LinearRing>
              <coordinates>
                78.1200,11.5300,0
                78.2200,11.5300,0
                78.2200,11.6400,0
                78.1200,11.6400,0
                78.1200,11.5300,0
              </coordinates>
            </LinearRing>
          </outerBoundaryIs>
        </Polygon>
      </Placemark>
    </Folder>
    
  </Document>
</kml>
